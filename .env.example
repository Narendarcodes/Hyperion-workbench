# HYPERION WORKBENCH — Environment Configuration Example
#
# Copy this file to .env and edit as needed.
# This file is loaded by the application at startup.
# Lines starting with # are comments.
#
# The workbench runs LOCAL-FIRST by default:
# - Default provider: local (llama.cpp via Ollama at http://127.0.0.1:11434/v1)
# - Default model: qwen3.5:4b
# - No API key required to start — it works out of the box with a local LLM server.
#
# To use cloud APIs, add keys below and select the provider in Settings → Models.

# ── DeepSeek (cloud) ──────────────────────────────────────────────────────
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── OpenAI (cloud) ────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-your-openai-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Anthropic (cloud) ─────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── Custom / Self-Hosted Gateway (OpenAI-compatible) ──────────────────────
# CUSTOM_GATEWAY_API_KEY=sk-your-gateway-key
# CUSTOM_GATEWAY_BASE_URL=http://your-gateway.example/v1

# ── Local Model Server (llama.cpp / Ollama / vLLM / LM Studio) ───────────
# LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1

# ── Indic ASR (Python FastAPI inference server) ──────────────────────────
# ASR_SERVER_URL=http://127.0.0.1:8008
# ASR_DEVICE=cuda  # or cpu

# ── Web Server ────────────────────────────────────────────────────────────
# DSH_WEB_HOST=127.0.0.1
# DSH_WEB_PORT=3080
# DSH_WEB_OPEN_BROWSER=true

# ── Telemetry (optional) ─────────────────────────────────────────────────
# DSH_TELEMETRY_DISABLED=1
# DSH_TELEMETRY_OTLP_URL=https://harness-telemetry.deepseeksvc.com/v1/logs

# ── Permission Mode ──────────────────────────────────────────────────────
# DSH_PERMISSION_MODE=workspace-write  # read-only | workspace-write | danger-full-access

# ── Development ───────────────────────────────────────────────────────────
# NODE_OPTIONS=--disable-warning=ExperimentalWarning